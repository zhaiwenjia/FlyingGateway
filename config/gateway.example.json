{
  "strategy": "priority",
  "endpoints": [
    {
      "name": "primary",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-6-luna",
      "upstream_model": "gpt-6-luna",
      "provider_name": "openai",
      "context_window": 128000,
      "max_output_tokens": 16384,
      "capabilities": {
        "supports_tools": true,
        "supports_stream": true,
        "supports_vision": true
      },
      "credential_ref": "OPENAI_API_KEY",
      "timeout_s": 30,
      "max_retries": 2,
      "priority": 0,
      "breaker": {
        "failure_threshold": 5,
        "cooldown_s": 30,
        "probe": 1
      },
      "rate_limit": {
        "tpm": 2000000,
        "rpm": 5000,
        "burst_s": 10
      },
      "concurrency_limit": 200,
      "limits_group": "openai-org"
    },
    {
      "name": "backup",
      "base_url": "https://api.deepseek.com/v1",
      "model": "gpt-6-luna",
      "upstream_model": "deepseek-chat",
      "provider_name": "deepseek",
      "context_window": 64000,
      "max_output_tokens": 8192,
      "capabilities": {
        "supports_tools": true,
        "supports_stream": true,
        "supports_vision": false
      },
      "credential_ref": "DEEPSEEK_API_KEY",
      "timeout_s": 45,
      "max_retries": 1,
      "priority": 1
    },
    {
      "name": "local",
      "base_url": "http://127.0.0.1:8000/v1",
      "model": "gpt-6-luna",
      "upstream_model": "qwen2.5-7b-instruct",
      "provider_name": "qwen",
      "context_window": 32768,
      "max_output_tokens": 8192,
      "capabilities": {
        "supports_tools": true,
        "supports_stream": true,
        "supports_vision": false
      },
      "credential_ref": "VLLM_API_KEY",
      "timeout_s": 60,
      "max_retries": 0,
      "priority": 2
    },
    {
      "name": "large-context",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o",
      "upstream_model": "gpt-4o",
      "provider_name": "openai",
      "context_window": 128000,
      "max_output_tokens": 16384,
      "capabilities": {
        "supports_tools": true,
        "supports_stream": true,
        "supports_vision": true
      },
      "credential_ref": "OPENAI_API_KEY",
      "timeout_s": 60,
      "max_retries": 2,
      "priority": 0
    }
  ],
  "fallback_chains": {
    "general": ["backup", "local"],
    "context_window": ["large-context"],
    "content_policy": ["backup"],
    "rate_limit": ["backup", "local"],
    "timeout": ["backup"],
    "upstream_error": ["backup", "local"]
  },
  "caller_rate_limits": [
    {
      "key_ref": "CALLER_KEY_FRONTEND",
      "tpm": 600000,
      "rpm": 600,
      "burst_s": 10
    }
  ]
}
