# ---- Go 构建产物与测试产物 ----
# go build / go test 的输出不入库。
bin/
*.exe
*.test
*.out
coverage.out
coverage.html
vendor/

# ---- 环境变量（含真值，不入库）----
.env
.env.local
.env.*.local

# ---- 工具缓存 ----
# Go 的构建缓存在 GOCACHE（默认 ~/Library/Caches/go-build），不在仓内；
# 这里只挡误生成在仓根的本地工具产物。
.cache/

# ---- Claude Code 运行态 ----
.claude/scheduled_tasks.lock

# ---- 本地工具产物（非本仓内容）----
# 临时目录：测试的临时家目录 / 工作区。异常退出或 Ctrl-C 会残留，
# 不 ignore 就会在 `git status` 里冒出来 ⇒ 可能被误提交进仓。
.tmp-test-*/

# ---- 运行期数据根（会话 / 输出，均可再生）----
.data/
output/
logs/
*.log
# ---- 参考代码（只读，不参与构建/测试/CI）----
# AGENTS.md 规则 18：历史代码一律只读，不参与构建、测试与 CI。
# reference/ 下存放外部项目的克隆/副本，仅供查阅实现参考。
reference/

# ---- macOS ----
# Finder 会在目录里塞 .DS_Store（. 开头 ⇒ git 默认不跟踪它，
# 但它会污染 `git status`，看着像有未跟踪改动）。
.DS_Store
